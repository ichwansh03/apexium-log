<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
      Local development: human-readable console output with the request id.
    -->
    <springProfile name="!docker">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} [%X{requestId:-}] - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!--
      Docker / deployed: structured JSON on stdout, consumed by Promtail -> Loki.
      The MDC (requestId) is emitted as an object: "mdc":{"requestId":"..."}.
    -->
    <springProfile name="docker">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
                <withSequenceNumber>false</withSequenceNumber>
                <withNanoseconds>false</withNanoseconds>
                <withContext>false</withContext>
                <withMarkers>false</withMarkers>
                <withArguments>false</withArguments>
                <withMessage>false</withMessage>
                <withFormattedMessage>true</withFormattedMessage>
                <withMDC>true</withMDC>
                <withThrowable>true</withThrowable>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

</configuration>
