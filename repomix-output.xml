  if (type === 'inline') {
    return (
      <div className="spinner-container" style={{ padding: '1rem' }}>
        <div className="spinner spinner-small"></div>
        <div className="loading-content">
          <span className="loading-text" style={{ fontSize: '0.9rem' }}>{message}</span>
